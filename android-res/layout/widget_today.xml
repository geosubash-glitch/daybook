<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="18dp"
    android:background="@drawable/widget_bg">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical" android:layout_marginEnd="12dp">
        <TextView android:id="@+id/w_weekday" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="SUNDAY" android:textColor="#9A978F" android:textSize="11sp" android:letterSpacing="0.18"
            android:fontFamily="sans-serif-medium" />
        <TextView android:id="@+id/w_date" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="4 October" android:textColor="#F2EFE8" android:textSize="26sp" android:fontFamily="serif"
            android:layout_marginTop="2dp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/w_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Nothing yet today" android:textColor="#9A978F" android:textSize="13sp"
            android:fontFamily="serif" android:textStyle="italic" android:layout_marginTop="10dp" />
        <TextView android:id="@+id/w_detail" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Tap to write" android:textColor="#9A978F" android:textSize="11sp" android:letterSpacing="0.06"
            android:fontFamily="sans-serif" android:layout_marginTop="2dp" />
    </LinearLayout>
    <ImageView android:id="@+id/w_grid" android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:scaleType="fitCenter" android:adjustViewBounds="true"
        android:contentDescription="This month: bright dots are days you wrote" />
</LinearLayout>
