<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted glass look: a light, mostly clear tint with a soft top-lit gradient and a bright hairline edge.
     (Android widgets cannot blur what is behind them, so the frost is drawn, not real blur.) -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient android:angle="270" android:startColor="#2EFFFFFF" android:endColor="#14FFFFFF" />
    <stroke android:width="1dp" android:color="#55FFFFFF" />
    <corners android:radius="24dp" />
</shape>
