<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted glass tile that follows the phone: tint, text colour and corner radius come from the system palette (Android 12+).
     Android widgets cannot blur what is behind them, so the frost is drawn. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/w_glass" />
            <corners android:radius="@dimen/w_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="@color/w_sheen_top" android:endColor="@color/w_sheen_bottom" />
            <stroke android:width="1dp" android:color="@color/w_stroke" />
            <corners android:radius="@dimen/w_radius" />
        </shape>
    </item>
</layer-list>
