<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid-glass look: a clear tint that is brighter at the top (light catching the edge),
     a bright outer hairline and a faint inner one for thickness.
     Android widgets cannot blur what is behind them, so this is drawn, not a real blur. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#38FFFFFF" android:centerColor="#16FFFFFF" android:endColor="#22FFFFFF" />
            <stroke android:width="1dp" android:color="#66FFFFFF" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item android:top="1.5dp" android:left="1.5dp" android:right="1.5dp" android:bottom="1.5dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#14FFFFFF" />
            <corners android:radius="25dp" />
        </shape>
    </item>
</layer-list>
