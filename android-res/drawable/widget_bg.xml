<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted / liquid-glass tile modelled on a milky, light-catching pane: a diagonal sheen from a bright
     top-left to a clearer bottom-right, a bright outer edge and a faint inner edge for thickness.
     Android widgets cannot blur what is behind them (the launcher draws them), so this is drawn, not real blur. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#52FFFFFF" android:centerColor="#26FFFFFF" android:endColor="#33FFFFFF" />
            <stroke android:width="1dp" android:color="#80FFFFFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#1AFFFFFF" />
            <corners android:radius="26dp" />
        </shape>
    </item>
</layer-list>
